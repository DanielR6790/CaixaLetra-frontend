# ============================================================
# CONFIGURAÇÕES DO FRONTEND
# Copie este arquivo para "frontend/.env" e preencha.
# ATENÇÃO: tudo que começa com VITE_ fica VISÍVEL no navegador.
# Coloque aqui SOMENTE a URL e a chave pública "anon".
# NUNCA coloque chaves secretas neste arquivo.
# ============================================================

VITE_SUPABASE_URL=COLE_AQUI_A_URL_DO_SEU_PROJETO_SUPABASE
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON

# Endereço do backend
VITE_API_URL=http://localhost:3001/api